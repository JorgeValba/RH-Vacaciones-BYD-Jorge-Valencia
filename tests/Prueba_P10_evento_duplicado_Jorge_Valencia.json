      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "// Elaborado por: Jorge Valencia.\nconst config=$('Evento de prueba').first().json;\nconst encontrado=$('Buscar evento duplicado').first().json;\nconst filas=$input.all().map(i=>i.json);\nif(filas.some(r=>r.error))throw new Error('No se pudo comprobar la tabla: '+JSON.stringify(filas));\nconst registros=filas.filter(r=>r.caso_id&&r.evento_id===config.evento.evento_id);\nif(encontrado.caso_id!==config.caso_esperado)throw new Error('El evento apunta a un folio diferente del esperado.');\nif(registros.length!==1)throw new Error('Se esperaba exactamente una fila para el evento; se encontraron '+registros.length);\nreturn [{json:{autor:'Jorge Valencia',prueba:'P10',resultado:'EVENTO_DUPLICADO_BLOQUEADO',ejecucion_n8n:$execution.id,registrado_en:new Date().toISOString(),evento_id:config.evento.evento_id,caso_id:encontrado.caso_id,eventos_en_tabla:registros.length,rama_observada:'false: evento ya registrado',abrir_otro_caso:false,operaciones_escritura_en_ensayo:0,llamadas_modelo_en_ensayo:0,alcance:'Consulta e IF del export aplicados a un evento histórico persistido; reproducción aislada y secuencial, no reenvío real del webhook de Telegram ni prueba de concurrencia.',siguiente_comprobacion:'Ejecutar de nuevo este workflow y comparar mismo evento, mismo folio y una sola fila.'}}];\n",
        "mode": "runOnceForAllItems"
      }
    },
